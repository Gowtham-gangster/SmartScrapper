# Server Configuration
SERVER_PORT=7504
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DATABASE_URL=jdbc:mysql://localhost:3306/smartscraper_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=smartscraper_user
DATABASE_PASSWORD=your_secure_password_here
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5

# Hibernate Configuration
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Thymeleaf Configuration
THYMELEAF_CACHE=true

# Admin User (fallback)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Scraping Configuration
SCRAPING_TIMEOUT=10000
MAX_URLS_PER_DOMAIN=2
TARGET_URL_COUNT=20
USER_AGENT=SmartScraper/1.0 (Educational Research Tool)

# Relevance Scoring
MIN_KEYWORD_FREQ=0.3
MIN_CONTENT_LENGTH=100
MIN_OVERALL_SCORE=0.4

# Pagination
PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/smartscraper.log
